{
  "name": "moment-exercise-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit --composite false --incremental false",
    "test": "vitest run",
    "serve": "node scripts/serve.mjs",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
